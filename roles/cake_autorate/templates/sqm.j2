config queue 'selective'
        option enabled '1'
        option interface '{{ cake_wan_device }}'
        option download '{{ cake_initial_download_kbps }}'
        option upload '{{ cake_initial_upload_kbps }}'
        option qdisc 'cake'
        option script 'selective_cake.qos'
        option linklayer 'none'
        option debug_logging '0'
        option verbosity '5'
