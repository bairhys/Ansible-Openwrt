#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
  if nft list table bridge iot_client_isolation >/dev/null 2>&1; then
    nft delete table bridge iot_client_isolation || return 1
  fi

  nft -f /etc/iot-client-isolation.nft
}

stop() {
  if nft list table bridge iot_client_isolation >/dev/null 2>&1; then
    nft delete table bridge iot_client_isolation
  fi
}
