#!/bin/sh /etc/rc.common
START=11
USE_PROCD=1
start_service() {
    [ -f /root/network-change-rollback.armed ] || return 0
    procd_open_instance
    procd_set_param command /bin/sh /usr/lib/network-change-rollback
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
